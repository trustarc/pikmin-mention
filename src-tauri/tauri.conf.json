{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pikmin Mention",
  "identifier": "com.trustarc.pikmin-mention",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Pikmin Mention",
        "width": 600,
        "height": 680,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Context-aware keyboard shortcut cheat sheet",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QTRBMzQ4OEY4RDE0MDkKUldRSkZJMlBTS09rOU93QVN3S3FKVUlRZnpHcW1ZTDlYWG9Qb1FEeCs5bmhPbElZTFFlb0Z4aEEK",
      "endpoints": [
        "https://github.com/trustarc/pikmin-mention/releases/latest/download/latest.json"
      ]
    }
  }
}
